# Template environment Mobile Dikasa.
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi:
#   cp .env.example .env

# Base URL backend. Selama BE belum siap, nilainya boleh dibiarkan.
API_BASE_URL=https://api.dikasa.local/v1

# true  = request dilayani MockApiInterceptor (tanpa backend, tanpa internet)
# false = request diteruskan ke API_BASE_URL di atas
USE_MOCK_API=true
